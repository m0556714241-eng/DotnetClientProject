# The SeatWise server address (WITHOUT /api at the end).
# Local: the https profile of SeatWise.API. On Render: the server's public URL.
# This is public configuration, not a secret - never put keys or passwords here.
VITE_API_URL=https://localhost:7180

# Show the demo-login buttons on the login screen (true / false)
VITE_SHOW_DEMO_LOGIN=true
